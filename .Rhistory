plot_f(x, y, region=c(lower_5, upper_5))
# Function to create plot
plot_f <- function(x, y, region=NULL, title="") {
df_plot <- data.frame(x=x, y=y)
p =  ggplot(df_plot, aes(x=x, y=y)) +
geom_line(size=1) +
{if(!is.null(region)) geom_ribbon(data=subset(df_plot, x >= region[1] & x <= region[2]),
aes(ymax=y), ymin=0, fill="red", alpha=0.3)} +
labs(title=title, x="Test Statistic", y="Density") +
theme_minimal()
if(region[1] != min(x)){ p = p + geom_vline(xintercept = region[1])}
if(region[2] != max(x)){ p = p + geom_vline(xintercept = region[2])}
return(p)
}
# 1. Upper 5% rejection region
plot_f(x, y, region=c(upper_5, max(x)))
p =  ggplot(df_plot, aes(x=x, y=y)) +
geom_line(size=1) +
geom_ribbon(data=subset(df_plot, x <= lower_25),
aes(ymax=y), ymin=0, fill="red", alpha=0.3) +
geom_ribbon(data=subset(df_plot, x >= upper_25),
aes(ymax=y), ymin=0, fill="red", alpha=0.3) +
labs( x="Test Statistic", y="Density") +
theme_minimal() +
geom_vline(xintercept = lower_25) +
geom_vline(xintercept = upper_25)
p
